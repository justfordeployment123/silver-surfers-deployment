# Milestone 3.1 product checkout
# Use Price IDs from the same Stripe mode as STRIPE_SECRET_KEY.
AI_EDGE_PRICE_ID=price_replace_with_ai_edge_price
ASSESSMENT_PRICE_ID=price_replace_with_assessment_price

# Create this secret from the webhook endpoint configured for this environment.
# Never commit the real whsec value.
STRIPE_WEBHOOK_SECRET=whsec_replace_with_environment_secret

# Existing application services required by Milestone 3.1.
ANTHROPIC_API_KEY=
AWS_S3_BUCKET=
AWS_REGION=
FRONTEND_URL=http://localhost:3000
