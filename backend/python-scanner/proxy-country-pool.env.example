# Opt-in country fallback. Do not put real credentials in this example.
SCANNER_PROXY_MODE=fallback
SCANNER_PROXY_COUNTRIES=us,pk,de
SCANNER_PROXY_SERVER=http://gate.nodemaven.com:8080
SCANNER_PROXY_USERNAME=YOUR_BASE_USERNAME-country-{country}-sid-{session}-filter-high
SCANNER_PROXY_PASSWORD=YOUR_PASSWORD

# Direct -> US -> Pakistan -> Germany; stops at the first successful audit.
# Each attempt launches a fresh browser through existing audit/discovery entry points.
# Countries are requested locations, not independently verified exit geolocation.
# Remove old region/city/ISP/ZIP restrictions from the username.
# No pool configured: existing single-proxy behavior is preserved.
# Budget is per audit/discovery invocation, NOT durable across SQS redelivery
# or global across all full-scan pages. Full scans may use three proxies per target.
# Country-specific job session IDs are stable, but browser cookies are not shared.
# Cross-country results can differ. These countries are not guaranteed low-risk IP pools.
